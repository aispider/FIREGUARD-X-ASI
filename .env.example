# FIREGUARD-X configuration. Copy to .env and edit. Never commit .env.

# --- Environment ---------------------------------------------------------
# development: demo logins are shown on the login screen, weak defaults allowed.
# production : the backend refuses to start with the default JWT secret or seed password.
APP_ENV=development

# --- Database / cache ----------------------------------------------------
POSTGRES_USER=fireguard
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=fireguard

# --- Security ------------------------------------------------------------
# At least 32 random characters. Generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
# Password given to the four seeded demo users (admin, commander, analyst, viewer).
SEED_PASSWORD=fireguard-demo
# Allows the Security Center tamper / inject demos (they only touch a simulated overlay, never original data).
ENABLE_SECURITY_DEMO=true

# --- Evidence ------------------------------------------------------------
# demo  : SYNTHETIC/DEMO chunks may support a TRUSTED result (clearly labelled in the UI).
# strict: only chunks ingested from official NASA sources can reach TRUSTED.
EVIDENCE_MODE=demo
# Download the official NASA NTRS documents on first start (needs internet from the worker container).
AUTO_INGEST=true
NTRS_BASE_URL=https://ntrs.nasa.gov

# --- AI (all optional) ---------------------------------------------------
# hash  : built-in deterministic lexical embedding (no network, no key).
# openai: OpenAI embeddings reduced to 384 dimensions (needs OPENAI_API_KEY).
EMBEDDING_PROVIDER=hash
# Optional narration of agent findings. Never changes scores, levels or evidence IDs; output is validated.
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Network -------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Behind a corporate proxy? Set these so the worker can reach ntrs.nasa.gov.
HTTP_PROXY=
HTTPS_PROXY=
